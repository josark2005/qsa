# Copy to .env.production before starting docker-compose.yml
APP_ENV=prod
LOG_LEVEL=INFO
TZ=Asia/Shanghai

POSTGRES_DB=qsa
POSTGRES_USER=qsa
# Use a long random password; it is used by both PostgreSQL and DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-password

CORS_ORIGINS=http://localhost:8080
# Set to true after HTTPS is enabled.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

HISTORY_DIR=/app/data/history
HISTORY_AUTO_IMPORT=false
QSA_REPORT_PDF_DIR=/app/data/reports
QQ_BOT_PUBLIC_BASE_URL=http://localhost:8080

# Only used when the users table is empty. Must satisfy the 12-character policy.
QSA_ADMIN_USERNAME=admin
QSA_ADMIN_PASSWORD=ChangeMe123456

# Optional: seed QQ credentials when the settings table has no values.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

HTTP_PORT=8080

# Image tag pushed by GitHub Actions: latest or a commit SHA.
QSA_IMAGE_TAG=latest
