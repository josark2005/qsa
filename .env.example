# Copy to .env before starting docker-compose.yml.
# Compose loads .env automatically for variable interpolation and env_file.
APP_ENV=prod
LOG_LEVEL=INFO
TZ=Asia/Shanghai

POSTGRES_DB=qsa
POSTGRES_USER=qsa
# Use a long random password; it is used by both PostgreSQL and DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-password

CORS_ORIGINS=http://localhost:8080
# Set to true after HTTPS is enabled.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

HISTORY_DIR=/app/data/history
HISTORY_AUTO_IMPORT=false
QSA_REPORT_PDF_DIR=/app/data/reports
QQ_BOT_PUBLIC_BASE_URL=http://localhost:8080

# Only used when the users table is empty. Must satisfy the 8-character policy.
QSA_ADMIN_USERNAME=admin
QSA_ADMIN_PASSWORD=ChangeMe123456

# Optional: seed QQ credentials when the settings table has no values.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# 可选：出站代理（腾讯/AkShare 走 requests，BaoStock 走原始 TCP，二者变量不同）。
# 容器内访问宿主机上的代理必须写 host.docker.internal：compose 已通过
# extra_hosts: host.docker.internal:host-gateway 映射（Linux 必需，Docker Desktop 兼容）。
# 宿主机代理需要监听 0.0.0.0 或局域网地址（例如 Clash 的 allow-lan）；
# 只监听 127.0.0.1 时容器连不上。容器里的 127.0.0.1 是容器自身，不要写。
# 修改本文件后需要重建容器才会重新注入：docker compose up -d backend worker
#
# HTTP(S)_PROXY 只影响腾讯/AkShare：
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,backend
#
# BaoStock 是原始 TCP（端口 10030），不认 HTTP(S)_PROXY，必须单独配置 SOCKS5：
# socks5h:// 表示域名由代理端解析，socks5:// 表示本地解析。
# BAOSTOCK_SOCKS_PROXY=socks5h://host.docker.internal:7893
#
# 管理端「系统设置 → 数据同步 → 网络代理」(sync.proxy_url) 非空时会覆盖进程内的
# HTTP_PROXY/HTTPS_PROXY/ALL_PROXY（清空或重启后恢复环境变量），但不影响 BaoStock。
# 用环境变量配置代理时，请把界面里的 sync.proxy_url 留空，避免互相覆盖。

HTTP_PORT=8080

# Image tag pushed by GitHub Actions: latest or a commit SHA.
QSA_IMAGE_TAG=latest
