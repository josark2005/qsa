APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://qsa:qsa@127.0.0.1:5432/qsa
REDIS_URL=redis://127.0.0.1:6379/0
USE_FAKE_REDIS=false

CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=qsa_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# QQ 机器人开放平台（AppID/AppSecret，Webhook 使用 AppSecret 验签）
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_API_BASE=https://api.bot.qq.com
QQ_BOT_PUBLIC_BASE_URL=http://127.0.0.1:5173

# 月度 SQLite 历史数据目录与启动自动导入
HISTORY_DIR=
HISTORY_AUTO_IMPORT=true
