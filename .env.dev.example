# Copy to .env.dev for docker-compose.dev.yml, or to .env for source-only development.
# docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
#
# 完整开发栈会把 .env.dev 通过 env_file 注入 backend/worker（显式 environment 优先）。
# 修改后需要重建容器：docker compose --env-file .env.dev -f docker-compose.dev.yml up -d backend worker
# 仅源码运行时 app 不会把 .env 导出到进程环境变量；需要代理时先执行
#   set -a; . ./.env; set +a
# 再启动后端/worker，否则 HTTP_PROXY / BAOSTOCK_SOCKS_PROXY 不会生效。
#
# Bind addresses for the published development ports.
# Use 127.0.0.1 for local-only access, 0.0.0.0 for LAN access.
DEV_BIND_IP=0.0.0.0

APP_ENV=dev
DATABASE_URL=postgresql+psycopg://qsa:qsa@127.0.0.1:5432/qsa
REDIS_URL=redis://127.0.0.1:6379/0
USE_FAKE_REDIS=false

POSTGRES_DB=qsa
POSTGRES_USER=qsa
POSTGRES_PASSWORD=qsa

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HISTORY_AUTO_IMPORT=true

QSA_ADMIN_USERNAME=admin
QSA_ADMIN_PASSWORD=DevPassword123

QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_PUBLIC_BASE_URL=http://localhost:5173

# 可选：出站代理（腾讯/AkShare 走 requests，BaoStock 走原始 TCP，二者变量不同）。
# 容器内访问宿主机上的代理必须写 host.docker.internal：compose 已通过
# extra_hosts: host.docker.internal:host-gateway 映射（Linux 必需）。
# 宿主机代理需要监听 0.0.0.0 或局域网地址（例如 Clash 的 allow-lan）；
# 只监听 127.0.0.1 时容器连不上。容器里的 127.0.0.1 是容器自身，不要写。
# 修改本文件后需要重建容器才会重新注入：
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d backend worker
#
# HTTP(S)_PROXY 只影响腾讯/AkShare：
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,backend
#
# BaoStock 是原始 TCP（端口 10030），不认 HTTP(S)_PROXY，必须单独配置 SOCKS5：
# BAOSTOCK_SOCKS_PROXY=socks5h://host.docker.internal:7893
#
# 管理端「系统设置 → 数据同步 → 网络代理」(sync.proxy_url) 非空时会覆盖进程内的
# HTTP(S)_PROXY/ALL_PROXY，但不影响 BaoStock；用环境变量时请把界面设置留空。
